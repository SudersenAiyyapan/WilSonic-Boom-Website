---
// The conversion plate. Appears at the foot of every page.
import site from '../data/site.json';
import { url, href } from './url';
interface Props { heading?: string[]; showSponsorsLink?: boolean; }
const { heading = ['Talk to us.'], showSponsorsLink = true } = Astro.props;
const mail = `mailto:${site.email}?subject=Sponsorship%20enquiry%20%E2%80%94%20FTC%2033001`;
---
<section class="band band--close">
  <div class="wrap">
    <div class="close" data-cut>
      <div class="close__l">
        <h2 class="h2 etch" data-etch set:html={heading.join('<br>')} />
        <p class="body"><slot>Email us with any question, or for more detail on the teams and the robot. If you supply parts or materials, tell us what they are and we will tell you where they would go.</slot></p>
      </div>
      <div class="close__r">
        <a class="btn btn--gold btn--lg" href={mail}>Email the team</a>
        <a class="btn btn--ghost btn--lg" href={href(site.sponsorshipPack)} download>
          <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2 L8 11" /><path d="M4.5 7.5 L8 11 L11.5 7.5" /><path d="M3 13.5 L13 13.5" /></svg>
          Download the pack
        </a>
        {showSponsorsLink && <a class="more more--quiet" href={url('/sponsor-the-team/')}><span>Tiers and how it works</span><svg viewBox="0 0 24 12" aria-hidden="true" focusable="false"><path d="M0 6 H21" /><path d="M16 1 L21 6 L16 11" /></svg></a>}
        <p class="close__meta"><span class="num">{site.email}</span><br>{site.address}</p>
      </div>
    </div>
  </div>
</section>
