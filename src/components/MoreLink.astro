---
// The one way this site says "there is more on another page".
import { url } from './url';
interface Props { href: string; }
const { href } = Astro.props;
---
<a class="more" href={url(href)}>
  <span><slot /></span>
  <svg viewBox="0 0 24 12" aria-hidden="true" focusable="false"><path d="M0 6 H21" /><path d="M16 1 L21 6 L16 11" /></svg>
</a>
