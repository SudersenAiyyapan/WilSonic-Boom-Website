---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../components/url';
---
<Base title="Page not found" current="home" description="This page does not exist on the Wilsonic Boom site.">
  <PageHead lines={['Page not', 'found.']}>
    <p class="lede">That address does not lead anywhere on this site.</p>
    <div class="actions actions--head">
      <a class="btn btn--gold" href={url('/')}>Back to the home page</a>
    </div>
  </PageHead>
</Base>
