---
// /sponsor-the-team — the pitch to a NEW sponsor: why, tiers, how it works.
// (Current sponsors have their own page, /sponsors.)
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Specs from '../components/Specs.astro';
import Close from '../components/Close.astro';
import MoreLink from '../components/MoreLink.astro';
import sponsors from '../data/sponsors.json';
import site from '../data/site.json';
const mail = `mailto:${site.email}?subject=Sponsorship%20enquiry%20%E2%80%94%20FTC%2033001`;
---
<Base title="Sponsor the team" current="sponsor" description="Sponsor Wilsonic Boom, FTC team 33001: what your support does, the tiers, and what happens after you get in touch.">

  <PageHead lines={['Sponsor', 'the team.']}>
    <p class="lede">
      Money, parts, machining or services — all of it goes into a robot that competes in public
      and a programme that is judged on how it is run.
    </p>
    <div class="actions actions--head">
      <a class="btn btn--gold" href={mail}>Email the team</a>
      <a class="btn btn--ghost" href={site.sponsorshipPack} download>
        <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2 L8 11" /><path d="M4.5 7.5 L8 11 L11.5 7.5" /><path d="M3 13.5 L13 13.5" /></svg>
        Sponsorship pack
      </a>
    </div>
  </PageHead>

  <!-- ═══ THE CASE ═══ -->
  <section class="band band--tight" id="why">
    <div class="wrap wrap--split">
      <div class="split__l"><h2 class="h2 etch" data-etch>What your money<br>actually does.</h2></div>
      <div class="split__r">
        <p class="body">
          An FTC season runs on parts that wear out and parts that did not exist until we made
          them. Sponsorship is the difference between rebuilding a subsystem that failed and
          living with it for the rest of the season.
        </p>
        <Specs rows={sponsors.budget} />
        <MoreLink href="/sponsors/">Who already supports us</MoreLink>
      </div>
    </div>
  </section>

  <!-- ═══ TIERS ═══ -->
  <section class="band band--alt" id="tiers">
    <div class="wrap">
      <h2 class="h2 etch" data-etch>Tiers</h2>
      <div class="tiers">
        {sponsors.tiers.map((t) => (
          <div class:list={['tier', { 'tier--lead': t.lead }]} data-cut>
            <p class="tier__name">{t.name}</p>
            <p class="tier__amt num">{t.from}</p>
            <ul class="tier__list">{t.gets.map((g) => <li>{g}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="body body--wide tiers__kind">{sponsors.inKind}</p>
    </div>
  </section>

  <!-- ═══ WHAT HAPPENS NEXT ═══ -->
  <section class="band band--alt" id="next">
    <div class="wrap">
      <h2 class="h2 etch" data-etch>What happens next</h2>
      <ol class="steps">
        <li class="step" data-cut>
          <span class="step__n num">01</span>
          <h3 class="h3">You email us</h3>
          <p class="body">One line is enough. Tell us what you make or what you would like to fund, and we reply within {sponsors.responseTime}.</p>
        </li>
        <li class="step" data-cut>
          <span class="step__n num">02</span>
          <h3 class="h3">We send the pack and talk</h3>
          <p class="body">You get the full sponsorship pack and, if you want it, {sponsors.meeting}. We will tell you exactly where your support would go.</p>
        </li>
        <li class="step" data-cut>
          <span class="step__n num">03</span>
          <h3 class="h3">We agree it in writing</h3>
          <p class="body">Placement, amount and what we owe you, confirmed by email before anything is printed. Invoicing and payment run through {sponsors.invoicing}.</p>
        </li>
      </ol>
    </div>
  </section>

  <Close showSponsorsLink={false} />
</Base>
