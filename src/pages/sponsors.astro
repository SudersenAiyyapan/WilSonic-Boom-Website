---
// /sponsors — the companies and people who already support the team, in
// proper detail. A thank-you, and proof to the next sponsor that support is
// visible and accounted for. The pitch to new sponsors is /sponsor-the-team.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Slot from '../components/Slot.astro';
import Close from '../components/Close.astro';
import sponsors from '../data/sponsors.json';
import { url } from '../components/url';

const list = [...sponsors.sponsors].sort((a, b) => Number(a.level ?? 2) - Number(b.level ?? 2));
const top = list.filter((s) => Number(s.level ?? 2) === 1);
const rest = list.filter((s) => Number(s.level ?? 2) !== 1);
---
<Base title="Sponsors" current="sponsors" description="The companies that support Wilsonic Boom, FTC team 33001 — who they are, what they gave, and what it went into.">

  <PageHead lines={['Our sponsors.']}>
    <p class="lede">
      Every part of this robot and every event we reach was paid for by someone. These are
      the companies behind the team: what they do, what they gave, and exactly where it went.
    </p>
  </PageHead>

  {top.length > 0 && (
    <section class="band band--tight" id="principal">
      <div class="wrap">
        <h2 class="h2 etch" data-etch>Principal sponsors</h2>
        <ul class="sponsor-list">
          {top.map((s) => (
            <li class="sp sp--top" data-cut>
              <div class="sp__logo"><Slot logo small spec="Logo · SVG or transparent PNG" src={s.logo} alt={s.name} /></div>
              <div class="sp__b">
                <h3 class="sp__name"><a class="inline" href={s.url}>{s.name}</a></h3>
                {s.since && <p class="sp__since num">Sponsor since {s.since}</p>}
                <p class="body">{s.about}</p>
                <dl class="specs specs--tight">
                  <div class="specs__row"><dt>Gave</dt><dd>{s.gave}</dd></div>
                  {s.wentInto && <div class="specs__row"><dt>Went into</dt><dd>{s.wentInto}</dd></div>}
                </dl>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class:list={['band', { 'band--alt': top.length > 0, 'band--tight': top.length === 0 }]} id="supporters">
      <div class="wrap">
        <h2 class="h2 etch" data-etch>{top.length > 0 ? 'Supporters' : 'Supported by'}</h2>
        <ul class="sponsor-list sponsor-list--grid">
          {rest.map((s) => (
            <li class="sp" data-cut>
              <div class="sp__logo"><Slot logo small spec="Logo · SVG or transparent PNG" src={s.logo} alt={s.name} /></div>
              <div class="sp__b">
                <h3 class="sp__name"><a class="inline" href={s.url}>{s.name}</a></h3>
                {s.since && <p class="sp__since num">Sponsor since {s.since}</p>}
                <p class="body">{s.about}</p>
                <p class="sp__gave"><span>Gave</span> {s.gave}</p>
                {s.wentInto && <p class="sp__gave"><span>Went into</span> {s.wentInto}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band band--tight" id="join">
    <div class="wrap wrap--split">
      <div class="split__l"><h2 class="h2 etch" data-etch>Join them.</h2></div>
      <div class="split__r">
        <p class="body">
          Sponsorship can be money, parts, machining or services, at whatever level suits you. See
          what each tier includes and what happens after you get in touch.
        </p>
        <a class="btn btn--gold join__btn" href={url('/sponsor-the-team/')}>Sponsor the team</a>
      </div>
    </div>
  </section>

  <Close heading={['Thank you.']} showSponsorsLink={false}>
    If you sponsor us and something here is out of date, like a logo, a line about your
    company or where your support went, tell us and we will fix it.
  </Close>
</Base>
